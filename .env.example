# ============================================================================
# QuickReply AI — Production Environment Configuration Template
# Copy this file to .env.local and populate with your actual credentials
# ============================================================================

# Application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/quickreply?retryWrites=true&w=majority

# Security & Secrets (Generate 32+ character random strings with `openssl rand -hex 32`)
SESSION_SECRET=your_super_secret_session_key_min_32_characters_here
JWT_SECRET=your_jwt_signing_secret_min_32_characters_here
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET=your_cron_execution_secret_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Meta / Instagram Professional Platform (Meta Graph API v19.0+)
# ─────────────────────────────────────────────────────────────────────────────
# Obtain from Meta for Developers (https://developers.facebook.com):
# 1. Create a "Business" type app.
# 2. Add "Instagram Graph API" and "Facebook Login for Business" products.
# 3. Add Redirect URI: http://localhost:3000/api/integrations/instagram/callback
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_secret_verify_token_here
META_GRAPH_API_VERSION=v19.0

# ─────────────────────────────────────────────────────────────────────────────
# AI & LLM Providers
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth 2.0 (YouTube Data & Analytics APIs)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Community & Company Platform (v202401)
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/auth/callback

# ─────────────────────────────────────────────────────────────────────────────
# Meta / WhatsApp Cloud API & Embedded Signup
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot API
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ─────────────────────────────────────────────────────────────────────────────
# Redis / Upstash (Distributed Queues & Rate Limiting)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:<password>@<host>:<port>

# ─────────────────────────────────────────────────────────────────────────────
# Payments & Billing (Stripe / Razorpay)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
